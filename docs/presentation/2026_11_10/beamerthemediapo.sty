%% PALETTES
%% Une palette par type de chapitre, choisie avec \SetPalette{<nom>}
%% (appelée par \Chapter, voir presentation.tex). Les couleurs portent le même
%% nom dans toutes les palettes : bulles, title, other, triangleinf,
%% trianglesup, appendix.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% --- palette "blue" : contribution 1 ---
\def\palette@blue{%
	\definecolor{bulles}{RGB}{19, 27, 42}%
	\definecolor{title}{RGB}{56, 78, 108}%
	\definecolor{other}{RGB}{79, 139, 151}%
	\definecolor{triangleinf}{RGB}{179, 212, 230}%
	\definecolor{trianglesup}{RGB}{179, 212, 230}%
	\definecolor{appendix}{RGB}{138, 172, 189}%
}

% --- palette "green" : contribution 2 (accordée au bleu : même luminosité et saturation) ---
\def\palette@green{%
	\definecolor{bulles}{RGB}{19, 42, 30}%
	\definecolor{title}{RGB}{70, 108, 56}%
	\definecolor{other}{RGB}{98, 151, 79}%
	\definecolor{triangleinf}{RGB}{195, 230, 179}%
	\definecolor{trianglesup}{RGB}{195, 230, 179}%
	\definecolor{appendix}{RGB}{154, 189, 138}%
}

% --- palette "duo" : parties communes (titre, introduction, background, conclusion) ---
% textes en noir et gris, triangle du haut bleu et triangle du bas vert
\def\palette@duo{%
	\definecolor{bulles}{RGB}{30, 30, 30}%
	\definecolor{title}{RGB}{40, 40, 40}%
	\definecolor{other}{RGB}{110, 110, 110}%
	\definecolor{trianglesup}{RGB}{179, 212, 230}%
	\definecolor{triangleinf}{RGB}{195, 230, 179}%
	\definecolor{appendix}{RGB}{160, 160, 160}%
}

% couleurs fixes des contributions (pastilles, cadres), indépendantes de la palette courante
\definecolor{cblue}{RGB}{79, 139, 151}
\definecolor{cgreen}{RGB}{98, 151, 79}

\newcommand{\SetPalette}[1]{%
	\csname palette@#1\endcsname
	\ifdefined\hypersetup\hypersetup{citecolor=other,linkcolor=title}\fi
}

% palette par défaut
\SetPalette{duo}

