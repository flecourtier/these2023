\RequirePackage[most]{tcolorbox}

% boîte théorème (couleur de la palette courante)
\newtcbtheorem{mytheo}{Theorem}{colback=other,
	colframe=other,
	arc=2mm,
	boxrule=0.5pt,
	breakable, enhanced jigsaw,
	width=\linewidth,
	opacityback=0.1
	}{th}
\resetcounteronoverlays{tcb@cnt@mytheo}

% pastille colorée devant une contribution : \contribdot{cblue} ou \contribdot{cgreen}
\newcommand{\contribdot}[1]{\tikz[baseline=-0.6ex]\fill[#1] (0,0) circle (0.13cm);}

% cadre d'une contribution : \begin{contribbox}{<couleur>}{<titre>} (cblue ou cgreen)
\newtcolorbox{contribbox}[2]{colback=#1!10, colframe=#1,
	arc=2mm, boxrule=0.5pt, title={#2},
	fonttitle=\rmfamily\large, coltitle=white}

