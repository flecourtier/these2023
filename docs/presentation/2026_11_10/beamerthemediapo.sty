% beamertheme.sty
% \ProvidesPackage{beamertheme}
\RequirePackage{silence}
\RequirePackage{etoolbox}
\RequirePackage{tikz}
\RequirePackage{fontspec}
\WarningsOff[mathdesign/mdbch]

\RequirePackage{diapocolors} % toutes les couleurs (palettes, hybridations, neutre...)

% color
\setbeamercolor{classic}{fg=black}
\setbeamercolor{title}{fg=title}
\setbeamercolor{author}{fg=other}
\setbeamercolor{institute}{fg=other}
\setbeamercolor{date}{fg=black!76}
\setbeamercolor{frametitle}{fg=title}
\setbeamercolor{normal text}{fg=black}
\setbeamercolor{structure}{fg=black}
\setbeamercolor{block title}{fg=title}

% font
\setromanfont{Georgia}
\usefonttheme{professionalfonts} % maths entièrement en Computer Modern (sinon lettres en Open Sans italique + symboles CM)
%\usefonttheme{serif} %fonctionne
\setsansfont[Scale=MatchLowercase]{Open Sans}
\setbeamerfont{classic}{family=\sffamily,series=\mdseries,size=\small}
\setbeamerfont{title}{family=\rmfamily,series=\bfseries,size=\LARGE}
\setbeamerfont{subtitle}{family=\rmfamily,series=\bfseries,size=\normalsize}
\setbeamerfont{author}{series=\mdseries, size=\large}
\setbeamerfont{institute}{size=\small,series=\mdseries}
\setbeamerfont{date}{size=\normalsize,series=\bfseries}
\setbeamerfont{frametitle}{family=\rmfamily,series=\bfseries,size=\Large}
\setbeamerfont{block title}{family=\rmfamily,size=\large}

\setbeamersize{text margin left=2em, text margin right=2em}

% template
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{caption}[numbered]
% \setbeamertemplate{title page}[default][left]
% \vphantom{gÉ} : hauteur et profondeur de la ligne du titre fixes, sinon le contenu monte ou descend de ~3 pt selon que le titre a des lettres qui descendent
\setbeamertemplate{frametitle}{\vskip0.01\paperheight\usebeamercolor[fg]{frametitle}\insertframetitle\vphantom{g\'E}} 
\setbeamertemplate{itemize item}{\textbullet}
\setbeamertemplate{itemize subitem}{--}
\setbeamertemplate{itemize subsubitem}{\textbullet}
% \setlength{\leftmargini}{1.25em}
% \setlength{\leftmarginii}{1em}
% \setlength{\leftmarginiii}{1em}
% note de bas de frame : sur la ligne du numéro de page et du titre court, entre les deux, avec un filet court et clair
\setbeamertemplate{footline}{\vskip0.017\paperheight}
\renewcommand*{\footnoterule}{\kern-3pt\hbox to \textwidth{\hspace*{1.2cm}\textcolor{black!30}{\rule{2.5cm}{0.4pt}}\hfil}\kern2.6pt}
\setbeamertemplate{footnote}{\noindent\hspace*{1.2cm}\hbox to 1.2em{\hfil\insertfootnotemark}\insertfootnotetext\par}

% titlepage
\pgfdeclareimage[height=0.05\paperheight]{logomimesis}{images/logos/logo-mimesis}
\pgfdeclareimage[height=0.08\paperheight]{logoinria}{images/logos/logo-inria}

% encadrement / collaborations de la page de titre (alignés à gauche sous l'auteur)
\newcommand{\supervisors}[1]{\def\insertsupervisors{#1}}
\newcommand{\collaborators}[1]{\def\insertcollaborators{#1}}
\supervisors{}\collaborators{}

\defbeamertemplate*{title page}{customized}[1][]
{
	\vspace{3pt}
	\includegraphics[height=0.07\paperheight]{images/logos/logo-inria}
	\hspace{0.3cm}
	\includegraphics[height=0.05\paperheight]{images/logos/logo-mimesis}
	\hspace{0.3cm}
	\includegraphics[height=0.05\paperheight]{images/logos/logo-anr} 
	\hfill
	\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate

	\vspace{15pt}
	\begin{center}
		\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par
		
		\vspace{15pt}
		\usebeamerfont{author}\usebeamercolor[fg]{author}\textbf{\insertauthor}\par
	\end{center}

	\vspace{6pt}
	{\normalsize\centering\let\inst\textsuperscript
	\textbf{Supervised by:} \insertsupervisors\par
	\vspace{3pt}
	\textbf{Joint work with:} \insertcollaborators\par}

	\vspace{8pt}
	\begin{center}
		\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par
	\end{center}
	
	% \normalsize
	% % \vspace{8pt}
	% Joint work with:  \\
	% \usebeamerfont{institute}H. Barucq, F. Faucher, N. Victorion and V. Michel-Dansac.\par
	
	\vspace{20pt}
	% \usebeamerfont{subtitle}
	\usebeamercolor[fg]{subtitle}\insertsubtitle\par
	
	\begin{flushright}
		\vspace{-68pt}
		\includegraphics[height=0.24\paperheight]{images/logos/logo-imag.png}\par
	\end{flushright}
}

% triangles et signature (éléments communs aux fonds)
% hauteur du triangle du haut (à gauche / à droite) : agrandi si la barre de navigation a deux lignes
\newif\ifdiapo@navtwo
% séparateur entre le nom du chapitre courant et ses sections
\def\diapo@namesep{\hskip.25cm\raisebox{-1.5ex}{\Large\textperiodcentered}\hskip.25cm}
\newif\ifdiapo@secparen
\diapo@secparenfalse % <- true : sections du chapitre courant entre parenthèses (hors version 2 lignes)
\newif\ifdiapo@navswap
\diapo@navswapfalse % <- (si navtwo=false) true : sections à gauche de la cellule, nom du chapitre courant à droite (prioritaire sur navcenter)
\newif\ifdiapo@navleft
\diapo@navlefttrue % <- (avec navcenter) true : le groupe nom + sections est aligné à gauche de sa cellule au lieu d'être centré
\newif\ifdiapo@navcenter
\diapo@navcentertrue % <- (si navtwo=false) true : nom du chapitre courant + ses sections centrés entre les 2 flèches ; false : nom à gauche, sections à droite
\diapo@navtwofalse % <- true : chapitre courant centré + sections sur une 2e ligne ; false : version une ligne
\newcommand{\bg@trL}{0.14}
\newcommand{\bg@trR}{0.107}
\ifdiapo@navtwo\renewcommand{\bg@trL}{0.17}\renewcommand{\bg@trR}{0.137}\fi
\newcommand{\bg@triangles}{%
	\fill[trianglesup] (current page.north west) -- +(0, -\bg@trL\paperheight) -- +(\paperwidth, -\bg@trR\paperheight) -- (current page.north east) -- cycle;
}
% signature : titre court seul, en petit italique (le triangle du bas n'existe plus qu'à la page de titre)
\newcommand{\bg@signature}{%
	\node[anchor=south east,inner sep=0pt,draw=none,xshift=-0.05\paperheight,yshift=0.03\paperheight] at (current page.south east) {\footnotesize\itshape\color{black!40}\beamer@shorttitle};% % texte brut : \insertshorttitle est un lien (coloré par hyperref)
}
\newcommand{\bg@pagenumber}{%
	\node[anchor=south west,inner sep=0pt,draw=none,xshift=0.05\paperheight,yshift=0.03\paperheight] at (current page.south west) {\usebeamerfont{footline}\usebeamercolor[fg]{footline}\ifcsname diapo@alab@\the\c@part\endcsname A\insertframenumber\else\insertframenumber\small/\insertmainframenumber\fi};%
}

% page de titre : triangles seuls
\newcommand{\BackgroundTitle}{
	\setbeamertemplate{background}{%
		\begin{tikzpicture}[overlay,remember picture]
			\renewcommand{\bg@trL}{0.14}\renewcommand{\bg@trR}{0.107}%
			\fill[titletrisup] (current page.north west) -- +(0, -\bg@trL\paperheight) -- +(\paperwidth, -\bg@trR\paperheight) -- (current page.north east) -- cycle;
			\fill[titletriinf] (current page.south west) -- +(0, 0.08\paperheight) -- +(\paperwidth, 0.14\paperheight) -- (current page.south east) -- cycle;
		\end{tikzpicture}
	}
}

% pages de chapitre : triangles + signature, sans numéro de page
\newcommand{\BackgroundChapter}{
	\setbeamertemplate{background}{%
		\begin{tikzpicture}[overlay,remember picture]
			\bg@triangles
			\bg@signature
		\end{tikzpicture}%
	}
	\setbeamertemplate{navigation symbols}{}
}

% diapos normales : triangles + signature + numéro de page
\newcommand{\Background}{
	\setbeamertemplate{background}{%
		\begin{tikzpicture}[overlay,remember picture]
			\bg@triangles
			\bg@signature
			\bg@pagenumber
		\end{tikzpicture}%
	}
}

% pour la biblio
\newcommand{\BackgroundBiblio}{
    \setbeamertemplate{background}{%
        \begin{tikzpicture}[overlay,remember picture]
            \fill[trianglesup] (current page.north west) -- +(0, -\bg@trL\paperheight) -- +(\paperwidth, -\bg@trR\paperheight) -- (current page.north east) -- cycle;
            % \fill[triangleinf] (current page.south west) -- +(0, 0.08\paperheight) -- +(\paperwidth, 0.14\paperheight) -- (current page.south east) -- cycle;
        \end{tikzpicture}%
    }
}

\setbeamercolor{footline}{fg=black}
\setbeamerfont{footline}{series=\bfseries,size=\normalsize}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% CHAPITRES
%% \Chapter{<palette>}{<libellé>}{<titre>} : \part dans la palette choisie (blue,
%%     green, duo), avec une page de chapitre : libellé et titre suivis d'un
%%     filet de couleur.
%% \Chapter*{<palette>} : nouveau \part dans la palette choisie, sans page de chapitre.
%% \Chapter*[<libellé>]{<palette>} : idem, mais le chapitre porte un nom dans la barre de navigation
%%     (ses sections s'affichent à la suite, comme pour une hybridation).
%% \Section*{<titre>} : \section sans page de début de section (elle reste dans
%%     les bulles). \Section{<titre>} équivaut à \section{<titre>}.
%% Toutes ces pages n'ont pas de numéro et ne sont pas comptées dans la numérotation.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{xparse}

\newcommand{\chapterlabel}{}
% note facultative de la page de chapitre : \def\chapternote{...} avant \Chapter ; « * » sur le titre, texte en bas (remise à zéro après la page)
\newcommand{\chapternote}{}
% même astérisque (Open Sans, maigre) sur le titre et dans la note, malgré la police du titre
\newcommand{\notestar}{{\sffamily\mdseries *}}
\def\Chapter@full#1#2#3{\SetPalette{#1}\def\chapterlabel{#2}%
	\protected@write\@auxout{}{\string\diapo@setlabel{\the\numexpr\value{part}+1\relax}{#1}{#2}}%
	\part{#3}}
% \Appendix{<palette>}{<libellé>}{<titre>} : annexe d'une hybridation (après la conclusion).
% Page de chapitre « Appendix – <libellé> », diapos numérotées A1, A2, … (recommencent à
% chaque annexe), barre du haut limitée à l'annexe courante.
\newif\ifdiapo@appendixstarted
\NewDocumentCommand{\Appendix}{m m m}{%
	\ifdiapo@appendixstarted\else\global\diapo@appendixstartedtrue\global\chapterpagefalse\appendix\fi
	\SetPalette{#1}\def\chapterlabel{Appendix -- #2}%
	\protected@write\@auxout{}{\string\diapo@setalabel{\the\numexpr\value{part}+1\relax}{#1}{Appendix -- #2}}%
	\setcounter{framenumber}{0}%
	\part{#3}}
\def\diapo@setalabel#1#2#3{\diapo@setlabel{#1}{#2}{#3}\global\expandafter\let\csname diapo@alab@#1\endcsname\relax}
% libellé (coloré) du chapitre n, relu par les pages de la partie commune
\def\diapo@setlabel#1#2#3{\global\expandafter\def\csname diapo@lab@#1\endcsname{#3}}
% lien d'un nom de chapitre : vers sa page de chapitre si elle existe (cible diapo@chap<n>, repérée
% dans le .aux par \diapo@cp), sinon vers la 1re page de sa 1re section
\def\diapo@cp#1{\global\expandafter\let\csname diapo@cp@#1\endcsname\relax}
\def\diapo@chaplink#1#2#3{\ifcsname diapo@cp@#2\endcsname\hyperlink{diapo@chap#2}{#3}\else\hyperlink{Navigation#1}{#3}\fi}
\newif\ifchapterpage
\chapterpagetrue
% \Chapter* ouvre quand même un \part (sections et bulles séparées du chapitre précédent)
\NewDocumentCommand{\Chapter}{s o m}{\IfBooleanTF{#1}{\SetPalette{#3}\global\chapterpagefalse\gdef\chapterlabel{}%
	\IfValueT{#2}{\protected@write\@auxout{}{\string\diapo@setlabel{\the\numexpr\value{part}+1\relax}{#3}{#2}}}\part{}}{\Chapter@full{#3}}}

\newif\ifsectionpage
\sectionpagetrue
\NewDocumentCommand{\Section}{s m}{\IfBooleanT{#1}{\global\sectionpagefalse}\section{#2}}

% page de chapitre
\AtBeginPart{
	\ifchapterpage
	{\setbeamertemplate{footline}{}
		\BackgroundChapter
		\protected@write\@auxout{}{\string\diapo@cp{\the\c@part}}%
		\begin{frame}[c]
			\hypertarget{diapo@chap\the\c@part}{}%
			\raggedright
			\ifx\chapterlabel\empty\else
				{\color{other}\sffamily\bfseries\Large\chapterlabel\par}
				\vspace{0.3cm}
			\fi
			{\usebeamerfont{title}\usebeamercolor[fg]{title}\LARGE\insertpart\ifx\chapternote\empty\else\textsuperscript{\notestar}\fi\par}
			\vspace{0.4cm}
			{\color{other}\rule{3cm}{1.5pt}\par}
			\ifx\chapternote\empty\else
				\vspace{0.8cm}
				{\footnotesize\color{black!60}\notestar\,\chapternote\par}
			\fi
		\end{frame}
	}
	\addtocounter{framenumber}{-1}
	\fi
	\global\chapterpagetrue
	\gdef\chapternote{}
}

% note facultative de la page de section : \SectionNote{texte} juste avant \section ; « * » sur le titre, texte sous le titre (comme \chapternote pour un chapitre)
\gdef\sectionnote{}
\NewDocumentCommand{\SectionNote}{m}{\gdef\sectionnote{#1}}

% pages de début de section (style des présentations précédentes)
\AtBeginSection[]{
	\ifsectionpage
	{\setbeamertemplate{footline}{}
		\BackgroundChapter
		\begin{frame}
			\vfill
			\centering
			\begin{beamercolorbox}[sep=5pt,shadow=true,rounded=true]{subtitle}
				\usebeamerfont{title}\insertsection\ifx\sectionnote\empty\else\textsuperscript{\notestar}\fi\par%
				\vspace{0.5cm}
			\end{beamercolorbox}
			\ifx\sectionnote\empty\else
				\vspace{0.4cm}
				{\raggedright\footnotesize\color{black!60}\leftskip=5pt \notestar\,\sectionnote\par}
			\fi
			\tableofcontents[sectionstyle=hide,subsectionstyle=show/show/hide]
			\vfill
		\end{frame}
	}
	\addtocounter{framenumber}{-1}
	\fi
	\global\sectionpagetrue
	\gdef\sectionnote{}
}

% pages de début de sous-section
\AtBeginSubsection[]{
	{\setbeamertemplate{footline}{}
		\BackgroundChapter
		\begin{frame}
			\vfill
			\centering
			\begin{beamercolorbox}[sep=5pt,shadow=true,rounded=true]{subtitle}
				\usebeamerfont{title}\insertsectionhead\par%
				\vspace{0.5cm}
			\end{beamercolorbox}
			\tableofcontents[sectionstyle=hide,subsectionstyle=show/shaded/hide]
			\vfill
		\end{frame}
	}
	\addtocounter{framenumber}{-1}
}

% barre de navigation, limitée au chapitre courant (plus de bulles : une par diapo faisait trop) :
%% - une seule ligne : tous les chapitres (voir plus bas) ;
%%   Pour une hybridation, ses sections suivent son nom (section courante en gras) ;
%%   titre court dans la barre avec \section[<court>]{<long>}. Pas de sous-sections.
\useoutertheme[subsection=false]{miniframes}
\newif\ifdiapo@cur
\newif\ifdiapo@first
\gdef\diapo@lastpart{0}
\let\diapo@sectionentry\sectionentry
\def\sectionentry#1#2#3#4#5{%
	\ifnum#5=\c@part\relax
		\diapo@sectionentry{#1}{#2}{#3}{#4}{#5}%
	\fi}
% pas de bulles
\def\slideentry#1#2#3#4#5#6{}
% rangée du bas : section courante en gras
\defbeamertemplate*{section in head/foot}{diapo}{\bfseries\insertsectionhead}
\defbeamertemplate*{section in head/foot shaded}{diapo}{\insertsectionhead}

% rangée du haut : tous les chapitres, séparés par un trait ; le chapitre courant prend
% toute la place restante. \diapo@items est construite depuis le fichier .nav :
% une entrée par section de la partie commune et une par hybridation.
\newdimen\diapo@acc \newdimen\diapo@fixed \newdimen\diapo@xcur \newdimen\diapo@wcur
\gdef\diapo@items{}
\def\diapo@collect{%
	\gdef\diapo@items{}\gdef\diapo@lastpart{0}%
	\def\slideentry##1##2##3##4##5##6{}%
	\def\sectionentry##1##2##3##4##5{%
		\ifcsname diapo@alab@\the\c@part\endcsname
			% page d'annexe : seulement l'annexe courante
			\ifnum##5=\c@part\relax
				\ifnum\diapo@lastpart=##5\relax\else
					\gdef\diapo@lastpart{##5}%
					\xdef\diapo@items{\unexpanded\expandafter{\diapo@items}\noexpand\diapo@it{0}{##1}{}{##3}{##5}}%
				\fi
			\fi
		\else\ifcsname diapo@alab@##5\endcsname\else
			\ifcsname diapo@lab@##5\endcsname
				\ifnum\diapo@lastpart=##5\relax\else
					\gdef\diapo@lastpart{##5}%
					\xdef\diapo@items{\unexpanded\expandafter{\diapo@items}\noexpand\diapo@it{0}{##1}{}{##3}{##5}}%
				\fi
			\else
				\xdef\diapo@items{\unexpanded\expandafter{\diapo@items}\noexpand\diapo@it{1}{##1}{\unexpanded{##2}}{##3}{##5}}%
			\fi
		\fi\fi}%
	\dohead}
\def\diapo@iscur#1#2#3{%
	\ifnum#1=1\relax\ifnum#2=\c@section\ifnum#3=\c@part\diapo@curtrue\else\diapo@curfalse\fi\else\diapo@curfalse\fi
	\else\ifnum#3=\c@part\diapo@curtrue\else\diapo@curfalse\fi\fi}
\newsavebox{\diapo@b}
\newdimen\diapo@w
\def\diapo@underline#1#2{%
	\sbox{\diapo@b}{#2}\diapo@w=\wd\diapo@b
	\hbox{\usebox{\diapo@b}\kern-\diapo@w\lower1.1ex\hbox{\vrule width\diapo@w height #1 depth 0pt}}}
% tous les noms de chapitre sont soulignés (le courant en gras et trait plus épais), pas les sections
\def\diapo@itembox#1#2#3#4#5{%
	\diapo@iscur{#1}{#2}{#5}%
	\hbox{\usebeamerfont{section in head/foot}\usebeamercolor[fg]{section in head/foot}%
		\ifnum#1=1\relax
			\ifdiapo@cur\diapo@underline{0.9pt}{\bfseries\hyperlink{Navigation#4}{#3}}\else\diapo@underline{0.3pt}{\hyperlink{Navigation#4}{#3}}\fi%
		\else
			\ifdiapo@cur
				\ifdiapo@navtwo
				% nom du chapitre centré, ses sections sur une 2e ligne répartie sur toute la cellule
				\vtop{\hbox to \diapo@wcur{\hfil\diapo@underline{0.9pt}{\bfseries\diapo@chaplink{#4}{#5}{\csname diapo@lab@#5\endcsname}}\hfil}%
					\vskip3pt\hbox to \diapo@wcur{\diapo@seclistw}}%
				\else
				% nom du chapitre à gauche, ses sections alignées à droite de sa cellule
				\ifdiapo@navswap
				\hbox to \diapo@wcur{\diapo@seclist\hfil\diapo@underline{0.9pt}{\bfseries\diapo@chaplink{#4}{#5}{\csname diapo@lab@#5\endcsname}}}%
				\else
				\ifdiapo@navcenter
				\hbox to \diapo@wcur{\ifdiapo@navleft\else\hfil\fi\diapo@underline{0.9pt}{\bfseries\diapo@chaplink{#4}{#5}{\csname diapo@lab@#5\endcsname}}%
					\ifx\diapo@secs\@empty\else\diapo@namesep\diapo@seclist\fi\hfil}%
				\else
				\hbox to \diapo@wcur{\diapo@underline{0.9pt}{\bfseries\diapo@chaplink{#4}{#5}{\csname diapo@lab@#5\endcsname}}%
					\hfil\diapo@seclist}%
				\fi
				\fi
				\fi
			\else
				\diapo@underline{0.3pt}{\diapo@chaplink{#4}{#5}{\csname diapo@lab@#5\endcsname}}%
			\fi
		\fi}}
\RequirePackage{pifont}
\def\diapo@sep{\hskip.25cm\raisebox{-0.4ex}{\ding{228}}\hskip.25cm}
\newcommand{\diapo@toprow}{%
	\diapo@acc=0pt \diapo@fixed=0pt \diapo@xcur=0pt \diapo@firsttrue
	{\usebeamercolor[fg]{section in head/foot}%
	 \setbox0\hbox{\diapo@sep}\dimen0=\wd0
	 \def\diapo@it##1##2##3##4##5{%
		\diapo@iscur{##1}{##2}{##5}%
		\ifdiapo@first\diapo@firstfalse\else\global\advance\diapo@acc by\dimen0 \global\advance\diapo@fixed by\dimen0 \fi
		\ifdiapo@cur
			\global\diapo@xcur=\diapo@acc
		\else
			\setbox2\hbox{\diapo@itembox{##1}{##2}{##3}{##4}{##5}}%
			\global\advance\diapo@fixed by\wd2
			\global\advance\diapo@acc by\wd2
		\fi}%
	 \setbox4\hbox{\diapo@items}}%
	\global\diapo@wcur=\dimexpr\paperwidth-0.6cm-\diapo@fixed\relax
	\diapo@firsttrue
	\hbox to \paperwidth{\hskip.3cm
		\usebeamercolor[fg]{section in head/foot}%
		\def\diapo@it##1##2##3##4##5{%
			\ifdiapo@first\diapo@firstfalse\else\diapo@sep\fi
			\diapo@iscur{##1}{##2}{##5}%
			\ifdiapo@cur\hbox to \diapo@wcur{\ifdiapo@navtwo\hfil\else\ifdiapo@navswap\hfil\else\ifdiapo@navcenter\ifdiapo@navleft\else\hfil\fi\fi\fi\fi\diapo@itembox{##1}{##2}{##3}{##4}{##5}\ifdiapo@navswap\ifdiapo@navtwo\hfil\fi\else\hfil\fi}%
			\else\diapo@itembox{##1}{##2}{##3}{##4}{##5}\fi}%
		\diapo@items\hss}}
% sections du chapitre courant (titres courts de la barre), à la suite de son nom
\newif\ifdiapo@sfirst
\gdef\diapo@secs{}
\def\diapo@collectsecs{%
	\gdef\diapo@secs{}%
	\def\slideentry##1##2##3##4##5##6{}%
	\def\sectionentry##1##2##3##4##5{%
		\ifnum##5=\c@part\relax
			\edef\diapo@tmpA{\unexpanded{##2}}\edef\diapo@tmpB{\csname diapo@lab@\the\c@part\endcsname}%
			\ifx\diapo@tmpA\diapo@tmpB\else
				\xdef\diapo@secs{\unexpanded\expandafter{\diapo@secs}\noexpand\diapo@sec{##1}{\unexpanded{##2}}{##3}}%
			\fi
		\fi}%
	\dohead}
\def\diapo@seclist{%
	\diapo@sfirsttrue
	\def\diapo@sec##1##2##3{%
		\ifdiapo@sfirst\diapo@sfirstfalse\else\hskip.25cm\textperiodcentered\hskip.25cm\fi
		{\itshape\ifnum##1=\c@section\bfseries\else\mdseries\fi\hyperlink{Navigation##3}{##2}}}%
	\raisebox{-0.4ex}{\ifdiapo@secparen(\hskip.08cm\fi\diapo@secs\ifdiapo@secparen\hskip.08cm)\fi}}
% version 2 lignes : sections réparties sur la largeur de la cellule
\def\diapo@seclistw{%
	\diapo@sfirsttrue
	\def\diapo@sec##1##2##3{%
		\ifdiapo@sfirst\diapo@sfirstfalse\else\hfil\textperiodcentered\fi\hfil
		{\itshape\ifnum##1=\c@section\bfseries\else\mdseries\fi\hyperlink{Navigation##3}{##2}}}%
	\hfil\diapo@secs\hfil}
\setbeamertemplate{headline}{%
	\begin{beamercolorbox}[colsep=1.5pt]{upper separation line head}
	\end{beamercolorbox}
	\begin{beamercolorbox}{section in head/foot}
		\vskip2pt
		{\diapo@collect}%
		{\diapo@collectsecs}%
		{\hypersetup{linkcolor=black}\diapo@toprow}%
		\vskip2pt
	\end{beamercolorbox}%
	\begin{beamercolorbox}[colsep=1.5pt]{lower separation line head}
	\end{beamercolorbox}
}
\setbeamercolor*{section in head/foot}{fg=black}

